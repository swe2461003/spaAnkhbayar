# Start: node --env-file=.env server/server.mjs (Node.js 24+)
PORT=4175
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4175
# Microsoft 365 work/school account; Excel workbook in OneDrive for Business/SharePoint
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# LMS_DATA_DIR must be backed up on a persistent volume. Never commit .data or .env.

# Personal-account workflow: local workbook, no Microsoft login required
EXCEL_MODE=local
# LMS_EXCEL_FILE=C:/path/to/LMS-Records.xlsx
